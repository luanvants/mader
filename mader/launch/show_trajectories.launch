<launch>
  <arg name="type_of_environment" default="dynamic_corridor"/>

  
  <!-- Launch RViz -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find mader)/rviz_cfgs/show_trajectories.rviz"/>

  <!-- Run play_bags_one_by_one.sh -->
  <node name="bag_player" pkg="mader" type="play_bags_one_by_one.sh" output="screen" />

  <node name="semantic_$(arg type_of_environment)" pkg="mader" type="$(arg type_of_environment).py" output="screen" args="80"/>	<!--  args is not used in dynamic_forest (TODO)-->
</launch>
